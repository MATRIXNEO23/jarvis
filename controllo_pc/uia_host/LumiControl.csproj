<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lettore degli elementi delle finestre (pulsanti, caselle, menu) tramite
       UI Automation di Windows, la stessa usata dai lettori di schermo.
       .NET Framework 4.8 (già in Windows 10): niente da installare, nessun modello. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LumiControl</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
